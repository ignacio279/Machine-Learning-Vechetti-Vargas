    "def autos_subvaluados(df, marca, modelo, umbral_pct=15):\n",
    "    subset = df[(df['Marca'] == marca) & (df['Modelo'] == modelo)]\n",
    "    \n",
    "    if len(subset) < 5:\n",
    "        print(\"No hay suficientes datos para este modelo.\")\n",
    "        return pd.DataFrame()\n",
    "    \n",
    "    precio_medio = subset['Precio'].median()\n",
    "    \n",
    "    umbral = precio_medio * (1 - umbral_pct / 100)\n",
    "    \n",
    "    subvaluados = subset[subset['Precio'] < umbral]\n",
    "    \n",
    "    print(f\"Precio mediano para {marca} {modelo}: USD {precio_medio:,.0f}\")\n",
    "    print(f\"Mostrando autos con precio al menos {umbral_pct}% por debajo (menores a USD {umbral:,.0f}):\")\n",
    "    \n",
    "    return subvaluados.sort_values('Precio')\n"
   ]
